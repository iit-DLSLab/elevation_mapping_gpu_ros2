# syntax=docker/dockerfile:1.4

# Base image
# ROS 2 Jazzy only ships apt packages for Ubuntu 24.04, while the official
# JetPack 6 images (l4t-jetpack:r36.x) are Ubuntu 22.04. So we start from plain
# Ubuntu 24.04 and install the Jetson (Tegra) CUDA/cuDNN builds on top, the same
# approach used by dusty-nv/jetson-containers for its r36 + 24.04 images.
# Host requirement: Jetson Orin with JetPack 6.x (L4T r36.x) + NVIDIA container runtime.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

# Metadata
LABEL description="ROS2 Jazzy environment with CUDA support for Jetson Orin (JetPack 6)"
LABEL version="2.0"

# Build arguments
ARG ROS_DISTRO=jazzy
ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=$USER_UID
ARG INSTALL_EMCUPY_ROSDEPS=true
ARG INSTALL_JETSON_ML=true
ARG SKIP_SEMANTIC_SENSOR=true
ARG PYPI_INDEX_URL=https://pypi.org/simple
# cu129 is the only JetPack 6 index with Python 3.12 (Ubuntu 24.04) torch wheels.
ARG JETSON_PIP_EXTRA_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu129
ARG TORCH_VERSION=2.8.0
ARG TORCHVISION_VERSION=0.23.0

# Jetson (Tegra) CUDA + cuDNN local repos. CUDA 12.9 runs on the JetPack 6
# (CUDA 12.6) driver via the cuda-compat libraries extracted below.
ARG CUDA_URL=https://developer.download.nvidia.com/compute/cuda/12.9.1/local_installers/cuda-tegra-repo-ubuntu2204-12-9-local_12.9.1-1_arm64.deb
ARG CUDA_PACKAGES="cuda-toolkit-12-9"
ARG CUDNN_URL=https://developer.download.nvidia.com/compute/cudnn/9.10.2/local_installers/cudnn-local-tegra-repo-ubuntu2204-9.10.2_1.0-1_arm64.deb
ARG CUDNN_PACKAGES="libcudnn9-cuda-12 libcudnn9-dev-cuda-12"

# Change this to the desired RMW implementation
# ARG RMW_NAME=zenoh
# ARG RMW_NAME=fastdds
ARG RMW_NAME=cyclonedds
#ARG RMW_NAME=fastrtps


# BUILD TYPE Debug, Release, RelWithDebInfo, MinSizeRel
ARG BUILD_TYPE=RelWithDebInfo 

ENV TURTLEBOT3_MODEL=waffle_realsense_depth
ENV CUDA_PATH=/usr/local/cuda
ENV CUPY_NVCC_GENERATE_CODE="arch=compute_87,code=sm_87"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=UTC \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=${PYPI_INDEX_URL} \
    PIP_EXTRA_INDEX_URL= \
    PIP_CONFIG_FILE=/dev/null \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_ROOT=/opt/ros/${ROS_DISTRO} \
    AMENT_PREFIX_PATH=/opt/ros/${ROS_DISTRO} \
    COLCON_PREFIX_PATH=/opt/ros/${ROS_DISTRO} \
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/usr/local/cuda/compat:/opt/ros/${ROS_DISTRO}/lib:/usr/local/cuda/lib64 \
    PATH=/opt/ros/${ROS_DISTRO}/bin:/usr/local/cuda/bin:/opt/local/bin:/opt/local/sbin:/usr/bin/c++:/usr/bin/make:$PATH \
    PYTHONPATH=/opt/ros/${ROS_DISTRO}/lib/python3.12/site-packages \
    # Used by various ROS2 packages
    RMW_IMPLEMENTATION=rmw_${RMW_NAME}_cpp \
    # Should be the same as above but with dashes instead of underscores
    RMW_IMPLEMENTATION_DASH=rmw-${RMW_NAME}-cpp \
    SKIP_SEMANTIC_SENSOR=${SKIP_SEMANTIC_SENSOR}

# Install basic utilities and dependencies
# RUN apt-key adv --keyserver keyserver.ubuntu.com --recv-keys F42ED6FBAB17C654 && \
#     apt update && apt install -y --no-install-recommends \
#         locales \
#         tzdata \
#         curl \
#         gnupg2 \
#         lsb-release \
#         sudo \
#         software-properties-common \
#         git-lfs \
#         nano \
#         pkg-config \
#     && locale-gen ${LANG} \
#     && update-locale LC_ALL=${LC_ALL} LANG=${LANG}\
#     && ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime \
#     && dpkg-reconfigure -f ${DEBIAN_FRONTEND} tzdata \
#     && apt clean \
#     && rm -rf /var/lib/apt/lists/*
# Bootstrap tools/locale that the plain Ubuntu image does not ship.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget ca-certificates gnupg2 lsb-release locales tzdata binutils xz-utils \
    && locale-gen en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Jetson CUDA toolkit + cuDNN (Tegra builds) and OpenBLAS (needed by Jetson torch).
# The local repo .debs are several GB, so download, install and purge them in one layer.
RUN set -ex \
    && mkdir -p /tmp/cuda && cd /tmp/cuda \
    && wget -q ${CUDA_URL} -O cuda-repo.deb && dpkg -i cuda-repo.deb && rm cuda-repo.deb \
    && cp /var/cuda-tegra-repo-*/cuda-*-keyring.gpg /usr/share/keyrings/ \
    # cuda-compat lets CUDA 12.9 run on the JetPack 6 driver. Extract it by hand:
    # its package depends on nvidia-l4t-core, which only exists on the host.
    && ar x /var/cuda-tegra-repo-*/cuda-compat-*.deb && tar xf data.tar.xz -C / \
    && wget -q ${CUDNN_URL} -O cudnn-repo.deb && dpkg -i cudnn-repo.deb && rm cudnn-repo.deb \
    && cp /var/cudnn-local-tegra-repo-*/cudnn-*-keyring.gpg /usr/share/keyrings/ \
    && apt-get update \
    && apt-get install -y --no-install-recommends ${CUDA_PACKAGES} ${CUDNN_PACKAGES} libopenblas-dev \
    && dpkg -P $(dpkg-query -W -f='${Package}\n' | grep -E '^(cuda-tegra-repo|cudnn-local-tegra-repo)') \
    && rm -rf /tmp/cuda /var/cuda-tegra-repo-* /var/cudnn-local-tegra-repo-* /var/lib/apt/lists/* \
    && apt-get clean \
    && ls /usr/local/cuda/compat/libcuda.so* \
    # Host Tegra driver libs are mounted here by the NVIDIA container runtime.
    && printf '/usr/lib/aarch64-linux-gnu/nvidia\n/usr/lib/aarch64-linux-gnu/tegra\n' > /etc/ld.so.conf.d/nvidia-tegra.conf \
    && ldconfig
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key  -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null && \
    apt-get update

# Utils
RUN apt update && \
    apt-get install -y git wget nano \
                       sudo gawk vim \
                       iputils-ping ssh \
                       byobu \
                       software-properties-common \
                       micro curl apt-transport-https tmux \
                       ca-certificates gnupg2 cmake 

# Dependencies 
RUN apt-get install -y python3-opencv \
                       python3-dev ninja-build \
	                   dirmngr build-essential \
                       python3-pip \
                       python3-yaml \
                       python3-tk \
                       python3-venv \
                       gnupg \
                       libbullet-dev \
                       libpython3-dev \
                       python3-colcon-common-extensions \
                       python3-flake8 \
                       python3-pytest-cov \
                       python3-rosdep \
                       python3-setuptools \
                       python3-vcstool \
                       python3-rosinstall-generator \
                       libasio-dev \
                       libtinyxml2-dev \
                       libcunit1-dev \
                       libgmp-dev \
                       libmpfr-dev

# Install ROS2
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null \
    && apt update && apt install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        python3-argcomplete \
        ros-${ROS_DISTRO}-${RMW_IMPLEMENTATION_DASH} \
        ros-${ROS_DISTRO}-topic-tools \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# Install development tools and dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt update && apt install -y --no-install-recommends \
        bash-completion \
        build-essential \
        cmake \
        gdb \
        openssh-client \
        python3-pip \
        python3-colcon-common-extensions \
        vim \
        doxygen \
        graphviz \
        python3-sphinx \
        python3-breathe \
        ros-dev-tools \
        ros-${ROS_DISTRO}-ament-* \
        python3-rosdep \
        libxine2-dev \
        libtiff-dev \
        libpostproc-dev \
        libopencv-dev \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# Pytorch
# Used by elevation_mapping_cupy and not rosdep resolvable for cuda version
# RUN python3 -m pip install -U --extra-index-url https://download.pytorch.org/whl/cu121 \
#     torch \
#     torchvision 

WORKDIR /home/${USERNAME}/workspace
COPY elevation_mapping_cupy /home/${USERNAME}/workspace/src/elevation_mapping_cupy
RUN python3 -m venv .map_env

# Install generic Python packages from PyPI.
RUN /home/${USERNAME}/workspace/.map_env/bin/pip install --no-cache-dir --retries 2 --timeout 120 \
    pip 'setuptools<80' wheel \
    colcon-clean \
    colcon-common-extensions \
    rosdoc2 \
    sphinx_rtd_theme \
    sphinx-multiversion \
    sphinx-copybutton \
    sphinx-tabs \
    autopep8 \
    flake8-builtins \
    flake8-comprehensions \
    flake8-docstrings \
    flake8-import-order \
    flake8-class-newline \
    flake8-blind-except \
    flake8-quotes \
    scikit-learn \
    opencv-python \
    simple-parsing \
    transforms3d \
    numpy==1.26.4 \
    ruamel.yaml \
    empy==3.3.4 \
    lark

# chainer ships only an sdist whose setup.py imports pkg_resources (removed in recent setuptools).
# Build it against the venv's pinned setuptools<80 instead of pip's isolated (latest) build env.
RUN /home/${USERNAME}/workspace/.map_env/bin/pip install --no-cache-dir --retries 2 --timeout 120 \
    --no-build-isolation chainer

# 1. Install Jetson ML wheels along with cuDSS
RUN if [ "${INSTALL_JETSON_ML}" = "true" ]; then \
        /home/${USERNAME}/workspace/.map_env/bin/pip uninstall -y \
            torch torchvision torchaudio cupy cupy-cuda11x cupy-cuda12x cupy-cuda13x numpy || true && \
        /home/${USERNAME}/workspace/.map_env/bin/pip install --no-cache-dir \
            --index-url ${JETSON_PIP_EXTRA_INDEX_URL} \
            torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} "numpy<2" "cupy-cuda12x<14" nvidia-cudss-cu12==0.8.0.10 ; \
    else \
        echo "Skipping Jetson ML wheels."; \
    fi

# 2. Install general dependencies from standard PyPI
# scikit-image 0.19 has no Python 3.12 wheels; 0.24 is the newest that still supports numpy<2.
RUN sed -i 's/shapely==1.7.1/# shapely==1.7.1/g; s/scikit-image==0.19/scikit-image==0.24.0/g' /home/${USERNAME}/workspace/src/elevation_mapping_cupy/requirements.txt && \
    /home/${USERNAME}/workspace/.map_env/bin/pip install --no-cache-dir --retries 2 --timeout 120 \
    "shapely>=2.0" \
    -r /home/${USERNAME}/workspace/src/elevation_mapping_cupy/requirements.txt

ENV LD_LIBRARY_PATH=/home/ros/workspace/.map_env/lib/python3.12/site-packages/nvidia/cu12/lib:${LD_LIBRARY_PATH}

# Set up non-root user (ubuntu:24.04 ships a default "ubuntu" user on UID/GID 1000)
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && (groupdel ubuntu 2>/dev/null || true) \
    && groupadd --gid $USER_GID $USERNAME \
    && useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Set up autocompletion and source ROS environment for user
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/$USERNAME/.bashrc \
    && echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /home/$USERNAME/.bashrc

# NVIDIA Container Toolkit belongs on the HOST, not inside the image (removed).


RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    if [ "$INSTALL_EMCUPY_ROSDEPS" = true ]; then \
        apt update && DEBIAN_FRONTEND=${DEBIAN_FRONTEND} apt install -y --no-install-recommends \
        # resolved by rosdep as boost
        libboost-all-dev\
        ### For elevation_mapping_cupy ####
        # rosdep grid_map_msgs
        ros-${ROS_DISTRO}-grid-map-msgs\
        # rosdep grid_map_ros
        ros-${ROS_DISTRO}-grid-map-ros\
        # rosdep image_transport
        ros-${ROS_DISTRO}-image-transport\
        # rosdep pcl_ros
        ros-${ROS_DISTRO}-pcl-ros\
        # rosdep cv_bridge
        ros-${ROS_DISTRO}-cv-bridge\
        # rosdep tf-transformations
        ros-${ROS_DISTRO}-tf-transformations\
        # rosdep rviz2
        ros-${ROS_DISTRO}-rviz2\
        # rosdep grid_map_cv
        ros-${ROS_DISTRO}-grid-map-cv\
        # rosdep grid_map_core
        ros-${ROS_DISTRO}-grid-map-core\
        # rosdep grid_map_demos
        ros-${ROS_DISTRO}-grid-map-demos\
        ros-${ROS_DISTRO}-point-cloud-transport\
        python3-shapely\
        python3-scipy\
        python3-ruamel.yaml\
        #################################
        ### For debugging elevation_mapping_cupy by setting up turtlebot3_simulations####
        # ros-${ROS_DISTRO}-turtlebot3*\
        ros-${ROS_DISTRO}-camera-calibration-parsers\
        ros-${ROS_DISTRO}-camera-info-manager\
        ros-${ROS_DISTRO}-turtlebot3-msgs\
        ros-${ROS_DISTRO}-turtlebot3-teleop\
        # replacing with rosdep gazebo_ros_pkgs
        ros-${ROS_DISTRO}-grid-map \
        ros-${ROS_DISTRO}-grid-map-msgs\
        ros-${ROS_DISTRO}-rqt-graph \
        ros-${ROS_DISTRO}-rqt-common-plugins\
        #ros-${ROS_DISTRO}-ros-gz \
        #############################################
        && apt clean && \
        rm -rf /var/lib/apt/lists/* ;\
    fi

ARG WORKSPACE="/home/${USERNAME}/workspace"

RUN mkdir -p ${WORKSPACE}/src/elevation_mapping_cupy && chown -R ${USER_UID}:${USER_GID} /home/${USERNAME}
RUN echo "if [ -f ${WORKSPACE}/install/setup.bash ]; then source ${WORKSPACE}/install/setup.bash; fi" >> /home/ros/.bashrc
WORKDIR ${WORKSPACE}

# Setup rosdep
RUN rm -f /etc/ros/rosdep/sources.list.d/20-default.list
RUN rm -rf /root/.ros/rosdep/sources.cache
RUN rosdep init

RUN ln -s ${WORKSPACE}/src/elevation_mapping_cupy/docker/extra_rosdeps.yaml /etc/ros/rosdep/sources.list.d/emcupy-rosdeps.yaml && \
        echo "yaml file:///etc/ros/rosdep/sources.list.d/emcupy-rosdeps.yaml" | tee /etc/ros/rosdep/sources.list.d/00-emcupy-rosdeps.list;

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ros2 topic list > /dev/null 2>&1 || exit 1

# Setup
RUN apt update && \
    vcs import /home/${USERNAME}/workspace/src < /home/${USERNAME}/workspace/src/elevation_mapping_cupy/docker/src.repos --recursive -w $(($(nproc)/2))

RUN rosdep update && \
    rosdep install --from-paths /home/${USERNAME}/workspace/src --ignore-src -y -r --skip-keys="numpy catkin roscpp gazebo_ros_pkgs gazebo_ros gazebo_plugins cupy-cuda12x numpy_lessthan_2 simple-parsing" 
    
SHELL ["/bin/bash", "-c"]
RUN bash /home/${USERNAME}/workspace/src/elevation_mapping_cupy/docker/build.sh

# Set the default command to bash
CMD ["bash"]